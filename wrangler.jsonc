{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jzib-public-welfare-points",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OPENAI_BASE_URL": "https://api.jzib.club/v1",
    "OPENAI_MODEL": "gpt-5.4",
    "ADMIN_BOOTSTRAP_USERNAME": "admin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jzib_points",
      "database_id": "49b2102d-d576-4fab-b1e6-a15b22d6e9a7",
      "migrations_dir": "migrations"
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jzib-campus-wall",
  "main": "src/index.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_BOOTSTRAP_USERNAME": "admin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jzib_points",
      "database_id": "49b2102d-d576-4fab-b1e6-a15b22d6e9a7",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "dev": {
      "name": "jzib-campus-wall-dev",
      "vars": {
        "ADMIN_BOOTSTRAP_USERNAME": "admin"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jzib_points_dev",
          "database_id": "236b82f2-7027-4734-a1a2-50c6c2ddb18e",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
